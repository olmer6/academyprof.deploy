		"fe4b8558-3dfb-4cae-b825-8ba4a4ef9b2d":  {
			"name": "\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e\u0431 \u0443\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u0435\u043d\u0438\u0438",
			"description": "\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e  \u0432\u044b\u0434\u0430\u0432\u0430\u0435\u043c\u043e\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\\\u0442\u0435 (\u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u0442\u0438\u044e, \u043e\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u043e",
			"access": "1",
			"repeatable": "0",
			"default": "\u041f\u043e \u0438\u0442\u043e\u0433\u0430\u043c \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0432\u044b\u0434\u0430\u0435\u0442\u0441\u044f \u0423\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u0435\u043d\u0438\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u0446\u0430 \u043e \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f (\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435) \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0438 \u0432\u044b\u0434\u0430\u043d\u043d\u043e\u0439 \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u043b\u0443\u0436\u0431\u043e\u0439 \u043f\u043e \u043d\u0430\u0434\u0437\u043e\u0440\u0443 \u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e \u0432 \u0441\u0444\u0435\u0440\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0435\u043c\u0435\u0440\u043e\u0432\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 (\u041a\u0443\u0437\u0431\u0430\u0441\u0441\u043e\u0431\u0440\u043d\u0430\u0434\u0437\u043e\u0440).",
			"jplugins": "1",
			"type": "textarea"
		},
